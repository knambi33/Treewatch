{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "TreeView — Every tree counts, Verified Live",
  "short_name": "TreeView",
  "description": "Every tree counts, Verified Live. Real-time geotagging, survival auditing, and TreeView Index™ leaderboards.",
  "id": "in.treeview.app",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#064e3b",
  "theme_color": "#059669",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["education", "environment", "productivity", "utilities"],
  "icons": [
    {
      "src": "/pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Plant New Tree",
      "short_name": "+ Plant",
      "description": "Geotag and photograph a newly planted sapling",
      "url": "/?action=plant",
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Camera Verification",
      "short_name": "Camera",
      "description": "Open camera to audit or verify tree health",
      "url": "/?action=camera",
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Green Leaders",
      "short_name": "Leaderboard",
      "description": "View verified Individual, School, NGO & City TreeView Indices",
      "url": "/?tab=leaderboard",
      "icons": [
        {
          "src": "/pwa-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
